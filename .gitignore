# ── OS / IDE ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ── Docker ────────────────────────────────────────────────────────────────────
docker-compose.override.yml   # developer-local overrides (optional: remove this line to commit shared overrides)

# ── Secrets — NEVER commit real secrets ───────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
kubeconfig
kubeconfig.*

# ── Helm ──────────────────────────────────────────────────────────────────────
helm/*/charts/
helm/*/Chart.lock
helm/*/*.tgz

# ── Build artifacts ───────────────────────────────────────────────────────────
vendor/
node_modules/
/tmp/
*.log

# ── Binaries — prevent accidentally committing downloaded executables ──────────
# Root-anchored so only a bare binary at repo root is ignored, not subdirectories.
/kind
/kubectl
/argocd
/helm        # ignore a binary called 'helm' at repo root
!/helm/      # but NOT the helm/ chart directory

# ── Terraform ─────────────────────────────────────────────────────────────────
terraform.tfvars
*.tfvars
!*.tfvars.example
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.backup
*.tfstate.lock.info
